# Copy to .env and fill in. .env is gitignored; never commit real credentials.

# Postgres connection string.
# A postgres:// URL (what Railway gives you) is rewritten to postgresql://
# automatically by app/config.py, so you can paste Railway's value unchanged.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# Used for both embeddings (text-embedding-ada-002) and chat completions.
OPENAI_API_KEY=sk-...

# Optional. Comma-separated CORS origins, only needed when the widget is
# embedded on a host other than the one serving it.
# ALLOWED_ORIGINS=https://teep.africa,https://www.teep.africa

# Per-IP rate limits on POST /api/chat. Defaults: 10/minute, 50/hour.
# Set either to 0 to disable that window.
# RATE_LIMIT_PER_MINUTE=10
# RATE_LIMIT_PER_HOUR=50

# Proxies in front of the app, used to pick the trustworthy entry out of
# X-Forwarded-For. 1 is correct for Railway; raise it only if you add a CDN.
# TRUSTED_PROXY_HOPS=1

# How much of the caller's address the rate limiter counts on. The /24 default
# makes one range share one allowance, so rotating through 152.233.29.1-.5 no
# longer buys five times the cap. Set 32 and 128 to count each address on its
# own, if these limits start catching real users behind a shared carrier IP.
# RATE_LIMIT_IPV4_PREFIX=24
# RATE_LIMIT_IPV6_PREFIX=64
